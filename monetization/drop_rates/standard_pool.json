  "on_chain_verification": {
    "rate_commitment": {
      "description": "Pool rates are committed on-chain at the start of each day (00:00 UTC). The keccak256 hash of this JSON (minus verification.signatures) is stored in the GachaRateCommitment contract.",
      "contract_address": "0xGachaRateCommitment",
      "commitment_frequency": "daily",
      "reveal_delay_blocks": 1
    },
    "pull_verification": {
      "description": "Each pull uses commit-reveal with VRF. Player commits a seed; contract reveals using blockhash+VRF after buffer blocks.",
      "vrf_contract": "0xVRFCoordinator",
      "callback_gas_limit": 200000,
      "request_confirmations": 3
    },
    "audit_log": {
      "description": "All pull results, rate commitments, and pity state transitions are emitted as events and indexed for public audit.",
      "events": [
        "RateCommitment(bytes32 indexed poolId, bytes32 indexed commitmentHash, uint256 timestamp)",
        "PullCommitted(bytes32 indexed pullId, address indexed player, uint256 blockNumber)",
        "PullRevealed(bytes32 indexed pullId, bytes32 indexed entropy, uint256 indexed itemId, uint8 rarity)",
        "PityStateUpdated(address indexed player, uint16 pullCount, uint8 pendingGuaranteeRarity)"
      ]
    }
